  <diagram name="Container With Most Water - O(n)" id="cwm-optimal">
    <mxGraphModel dx="1556" dy="2213" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
